{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nexting-ai/devices/schemas/message.schema.json",
  "title": "Nexting Device Protocol Experimental 0.2 message",
  "oneOf": [
    { "$ref": "#/$defs/present" },
    { "$ref": "#/$defs/answer" },
    { "$ref": "#/$defs/resolved" },
    { "$ref": "#/$defs/error" },
    { "$ref": "#/$defs/status" },
    { "$ref": "#/$defs/navPresent" },
    { "$ref": "#/$defs/navMove" },
    { "$ref": "#/$defs/navSelect" },
    { "$ref": "#/$defs/navResolved" },
    { "$ref": "#/$defs/keymap" },
    { "$ref": "#/$defs/keyEvent" },
    { "$ref": "#/$defs/rotaryMap" },
    { "$ref": "#/$defs/rotaryEvent" },
    { "$ref": "#/$defs/rotaryPress" },
    { "$ref": "#/$defs/voiceEvent" },
    { "$ref": "#/$defs/voiceState" },
    { "$ref": "#/$defs/text" },
    { "$ref": "#/$defs/usage" },
    { "$ref": "#/$defs/usageClear" },
    { "$ref": "#/$defs/config" },
    { "$ref": "#/$defs/configResult" }
  ],
  "$defs": {
    "deviceInfo": {
      "type": "object",
      "required": [
        "protocol",
        "spec",
        "wire",
        "profiles",
        "model",
        "fw",
        "max_message_bytes",
        "max_summary_bytes"
      ],
      "properties": {
        "protocol": { "const": "nexting-device" },
        "spec": { "$ref": "#/$defs/descriptor" },
        "wire": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "contains": { "const": 1 },
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "contains": { "const": "approval/1" },
          "items": { "$ref": "#/$defs/profileName" }
        },
        "model": { "$ref": "#/$defs/descriptor" },
        "fw": { "$ref": "#/$defs/descriptor" },
        "max_message_bytes": {
          "type": "integer",
          "minimum": 512,
          "maximum": 4294967295
        },
        "max_summary_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        },
        "statusSlots": { "type": "integer", "minimum": 0, "maximum": 8 },
        "device_id": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
        },
        "manufacturer": { "$ref": "#/$defs/descriptor" },
        "display_name": { "$ref": "#/$defs/descriptor" },
        "serial_number": { "$ref": "#/$defs/descriptor" },
        "button_count": { "type": "integer", "minimum": 0, "maximum": 1024 },
        "approval_button_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "custom_button_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "rotary_count": { "type": "integer", "minimum": 0, "maximum": 64 },
        "rotary_press_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "battery_service": { "type": "boolean" },
        "display": {
          "type": "object",
          "required": ["type", "width", "height"],
          "properties": {
            "type": { "$ref": "#/$defs/profileName" },
            "width": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "height": { "type": "integer", "minimum": 1, "maximum": 4096 }
          }
        },
        "haptics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/profileName" }
        },
        "vendor": { "$ref": "#/$defs/vendorInfo" }
      },
      "x-maxUtf8Bytes": 4096
    },
    "descriptor": {
      "type": "string",
      "minLength": 1,
      "x-maxUtf8Bytes": 64,
      "$comment": "Printable text with no control characters; the normative limit counts UTF-8 bytes."
    },
    "profileName": {
      "type": "string",
      "minLength": 1,
      "x-maxUtf8Bytes": 32
    },
    "vendorInfo": {
      "type": "object",
      "required": ["namespace", "facts"],
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}\\.)+[a-z0-9][a-z0-9-]{0,62}$",
          "x-maxUtf8Bytes": 128
        },
        "facts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["key", "label", "value"],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$"
              },
              "label": { "$ref": "#/$defs/descriptor" },
              "value": {
                "oneOf": [
                  { "type": "string", "minLength": 1, "x-maxUtf8Bytes": 128 },
                  { "type": "integer" }
                ]
              }
            }
          }
        }
      },
      "x-maxUtf8Bytes": 1024
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "base": {
      "type": "object",
      "required": ["v", "t", "id"],
      "properties": {
        "v": { "const": 1 },
        "t": { "type": "string" },
        "id": { "$ref": "#/$defs/id" }
      }
    },
    "present": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["sum", "opt", "ttl"],
          "properties": {
            "t": { "const": "present" },
            "sum": {
              "type": "string",
              "x-maxUtf8Bytes": 240,
              "$comment": "The normative limit is 240 UTF-8 bytes. Standard JSON Schema maxLength counts characters, so conformance tooling must enforce x-maxUtf8Bytes."
            },
            "opt": { "const": ["allow", "deny"] },
            "ttl": { "type": "integer", "minimum": 1, "maximum": 300000 }
          }
        }
      ]
    },
    "answer": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["ch"],
          "properties": {
            "t": { "const": "answer" },
            "ch": { "enum": ["allow", "deny"] }
          }
        }
      ]
    },
    "resolved": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["r"],
          "properties": {
            "t": { "const": "resolved" },
            "r": { "enum": ["answered", "expired", "cancelled", "replaced"] }
          }
        }
      ]
    },
    "error": {
      "type": "object",
      "required": ["v", "t", "code"],
      "properties": {
        "v": { "const": 1 },
        "t": { "const": "error" },
        "id": { "$ref": "#/$defs/id" },
        "code": {
          "enum": [
            "bad_message",
            "message_too_large",
            "unsupported_version",
            "unsupported_profile",
            "unknown_request",
            "not_authorized",
            "busy"
          ]
        }
      }
    },
    "status": {
      "type": "object",
      "required": ["v", "t", "agents"],
      "properties": {
        "v": { "const": 1 },
        "t": { "const": "status" },
        "agents": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["slot", "state"],
            "properties": {
              "slot": { "type": "integer", "minimum": 0, "maximum": 7 },
              "state": {
                "enum": [
                  "idle",
                  "thinking",
                  "working",
                  "complete",
                  "needs_input",
                  "error"
                ]
              },
              "label": {
                "type": "string",
                "x-maxUtf8Bytes": 64,
                "$comment": "The normative limit is 1-64 UTF-8 bytes with no control characters. Standard JSON Schema cannot count UTF-8 bytes or reject control characters, so conformance tooling must enforce x-maxUtf8Bytes and the control-character rule. Slot uniqueness within one message is also enforced outside the schema."
              }
            }
          }
        }
      }
    },
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "safeCounter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "gesture": {
      "enum": ["press", "release", "hold", "double"]
    },
    "navPresent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "t", "id", "items", "cursor", "ttl"],
      "properties": {
        "v": { "const": 1 },
        "t": { "const": "nav_present" },
        "id": { "$ref": "#/$defs/id" },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "x-maxUtf8Bytes": 64
          }
        },
        "cursor": { "type": "integer", "minimum": 0, "maximum": 7 },
        "ttl": { "type": "integer", "minimum": 1, "maximum": 300000 }
      }
    },
    "navMove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "t", "id", "dir", "seq"],
      "properties": {
        "v": { "const": 1 },
        "t": { "const": "nav_move" },
        "id": { "$ref": "#/$defs/id" },
        "dir": { "enum": ["prev", "next", "up", "down", "left", "right"] },
        "seq": { "$ref": "#/$defs/u32" }
      }
    },
    "navSelect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "t", "id", "index", "seq"],
      "properties": {
        "v": { "const": 1 },
        "t": { "const": "nav_select" },
        "id": { "$ref": "#/$defs/id" },
        "index": { "type": "integer", "minimum": 0, "maximum": 7 },
        "seq": { "$ref": "#/$defs/u32" }
      }
    },
    "navResolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "t", "id", "r"],
      "properties": {
        "v": { "const": 1 },
        "t": { "const": "nav_resolved" },
        "id": { "$ref": "#/$defs/id" },
        "r": { "enum": ["selected", "cancelled", "expired", "replaced"] }
      }
    },
    "keyPresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "label", "enabled", "light"],
      "properties": {
        "slot": { "type": "integer", "minimum": 0, "maximum": 63 },
        "label": { "type": "string", "minLength": 1, "x-maxUtf8Bytes": 32 },
        "enabled": { "type": "boolean" },
        "light": { "enum": ["off", "dim", "solid", "pulse"] },
        "rgb": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        }
      }
    },
    "keymap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "t", "rev", "keys"],
      "properties": {
        "v": { "const": 1 },
        "t": { "const": "keymap" },
        "rev": { "$ref": "#/$defs/u32" },
        "keys": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/keyPresentation" }
        }
      }
    },
    "keyEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "t", "slot", "event", "seq"],
      "properties": {
        "v": { "const": 1 },
        "t": { "const": "key_event" },
        "slot": { "type": "integer", "minimum": 0, "maximum": 63 },
        "event": { "$ref": "#/$defs/gesture" },
        "seq": { "$ref": "#/$defs/u32" }
      }
    },
    "rotaryControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "label", "value", "min", "max", "wrap"],
      "properties": {
        "slot": { "type": "integer", "minimum": 0, "maximum": 15 },
        "label": { "type": "string", "minLength": 1, "x-maxUtf8Bytes": 32 },
        "value": { "type": "integer", "minimum": -1000000, "maximum": 1000000 },
        "min": { "type": "integer", "minimum": -1000000, "maximum": 1000000 },
        "max": { "type": "integer", "minimum": -1000000, "maximum": 1000000 },
        "wrap": { "type": "boolean" }
      }
    },
    "rotaryMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "t", "rev", "controls"],
      "properties": {
        "v": { "const": 1 },
        "t": { "const": "rotary_map" },
        "rev": { "$ref": "#/$defs/u32" },
        "controls": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/rotaryControl" }
        }
      }
    },
    "rotaryEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "t", "slot", "delta", "seq"],
      "properties": {
        "v": { "const": 1 },
        "t": { "const": "rotary_event" },
        "slot": { "type": "integer", "minimum": 0, "maximum": 15 },
        "delta": { "type": "integer", "minimum": -127, "maximum": 127, "not": { "const": 0 } },
        "seq": { "$ref": "#/$defs/u32" }
      }
    },
    "rotaryPress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "t", "slot", "event", "seq"],
      "properties": {
        "v": { "const": 1 },
        "t": { "const": "rotary_press" },
        "slot": { "type": "integer", "minimum": 0, "maximum": 15 },
        "event": { "$ref": "#/$defs/gesture" },
        "seq": { "$ref": "#/$defs/u32" }
      }
    },
    "voiceEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "t", "event", "seq"],
      "properties": {
        "v": { "const": 1 },
        "t": { "const": "voice_event" },
        "event": { "enum": ["start", "stop", "cancel"] },
        "seq": { "$ref": "#/$defs/u32" }
      }
    },
    "voiceState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "t", "state"],
      "properties": {
        "v": { "const": 1 },
        "t": { "const": "voice_state" },
        "state": { "enum": ["idle", "listening", "transcribing", "submitted", "error"] },
        "label": { "type": "string", "minLength": 1, "x-maxUtf8Bytes": 64 }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "t", "channel", "content"],
      "properties": {
        "v": { "const": 1 },
        "t": { "const": "text" },
        "channel": { "type": "integer", "minimum": 0, "maximum": 7 },
        "title": { "type": "string", "minLength": 1, "x-maxUtf8Bytes": 64 },
        "content": { "type": "string", "x-maxUtf8Bytes": 1024 }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "t", "model", "input_tokens", "output_tokens"],
      "properties": {
        "v": { "const": 1 },
        "t": { "const": "usage" },
        "model": { "type": "string", "minLength": 1, "x-maxUtf8Bytes": 64 },
        "input_tokens": { "$ref": "#/$defs/safeCounter" },
        "output_tokens": { "$ref": "#/$defs/safeCounter" },
        "cached_tokens": { "$ref": "#/$defs/safeCounter" },
        "context_used": { "$ref": "#/$defs/safeCounter" },
        "context_limit": { "$ref": "#/$defs/safeCounter" }
      },
      "dependentRequired": {
        "context_used": ["context_limit"],
        "context_limit": ["context_used"]
      }
    },
    "usageClear": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "t"],
      "properties": {
        "v": { "const": 1 },
        "t": { "const": "usage_clear" }
      }
    },
    "configEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "value": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "integer", "minimum": -1000000, "maximum": 1000000 },
            { "type": "string", "x-maxUtf8Bytes": 128 }
          ]
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "t", "rev", "entries"],
      "properties": {
        "v": { "const": 1 },
        "t": { "const": "config" },
        "rev": { "$ref": "#/$defs/u32" },
        "entries": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/configEntry" }
        }
      }
    },
    "configResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "t", "rev", "status"],
      "properties": {
        "v": { "const": 1 },
        "t": { "const": "config_result" },
        "rev": { "$ref": "#/$defs/u32" },
        "status": { "enum": ["applied", "rejected"] },
        "code": { "enum": ["unknown_key", "invalid_value", "storage_error", "unsupported"] }
      }
    }
  }
}
